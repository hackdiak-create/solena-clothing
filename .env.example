# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL de base de l'application (en local ou en production)
# Exemples :
# Local : http://localhost:3000
# Production : https://mon-site.onrender.com ou https://mon-domaine.com
BASE_URL="http://localhost:3000"
APP_URL="MY_APP_URL"

# =========================================================================
# CONFIGURATION PASSERELLE DE PAIEMENT PAYTECH SÉNÉGAL (paytech.sn)
# =========================================================================
# 1. PAYTECH_API_KEY : Clé d'API publique PayTech
# 2. PAYTECH_API_SECRET : Clé secrète privée PayTech (à garder strictement confidentielle)
# 3. PAYTECH_ENV : "test" pour l'environnement Sandbox, "prod" pour la production
# =========================================================================
PAYTECH_API_KEY="VOTRE_CLE_API_PAYTECH_ICI"
PAYTECH_API_SECRET="VOTRE_CLE_SECRETE_PAYTECH_ICI"
PAYTECH_ENV="test"

# =========================================================================
# SUPABASE — stockage persistant PostgreSQL + Storage
# À configurer côté Render/.env, jamais dans le frontend
# =========================================================================
SUPABASE_URL="https://VOTRE_PROJET.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="VOTRE_SERVICE_ROLE_KEY_SUPABASE"

# Administration (à définir dans Render, pas dans GitHub)
ADMIN_USERNAME="solena"
ADMIN_PASSWORD="CHANGEZ_MOI"
ADMIN_SECRET_KEY="CHANGEZ_MOI_AVEC_UNE_LONGUE_CLE_ALEATOIRE"
